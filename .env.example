# Copy to .env and adjust if needed. Host ports are remapped because
# local services already occupy 3306 (MySQL) and 5432 (PostgreSQL).
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=rootpass123
MYSQL_DATABASE=aicte_institutes
MYSQL_USER=aicte_app
MYSQL_PASSWORD=aicte_pass

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
COURSES_DB=courses_db
FACULTY_DB=faculty_db
PHASE1_DB=phase1_resumes

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=aicte_scholarships

# Phase 4 — Groq LLM (answer synthesis + text-to-SQL)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ─────────────────────────────────────────────────────────────────────────────
# HOSTED DEPLOYMENT (Koyeb / Fly.io / Railway / Render)
# ─────────────────────────────────────────────────────────────────────────────
# On a hosting platform you do NOT ship .env — you set these in the
# platform's dashboard / `fly secrets` / `koyeb env` instead:
#
#   DATABASE_URL=postgresql://user:pass@host:5432/aicte_canonical?sslmode=require
#   GROQ_API_KEY=gsk_...
#
# DATABASE_URL is the connection string of your hosted PostgreSQL+pgvector
# instance (Neon, Supabase, Fly Postgres, ...). When set, every module in the
# API (VECTOR_STORE, DB_LOADER, TEXT_TO_SQL) uses it and ignores the
# individual POSTGRES_* variables above. Set it locally too if you want to
# point the API at a remote database:
#
#   DATABASE_URL=postgresql://user:pass@host:5432/aicte_canonical?sslmode=require
#
# To load the phase4_data/ package into a hosted database, run:
#   internalenv/Scripts/python.exe load_phase4_data.py --url "$DATABASE_URL"
