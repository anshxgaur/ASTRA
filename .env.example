# Copy to .env and adjust if needed. Host ports are remapped because
# local services already occupy 3306 (MySQL) and 5432 (PostgreSQL).
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=rootpass123
MYSQL_DATABASE=aicte_institutes
MYSQL_USER=aicte_app
MYSQL_PASSWORD=aicte_pass

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
COURSES_DB=courses_db
FACULTY_DB=faculty_db

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=aicte_scholarships

# Phase 4 — Groq LLM (answer synthesis + text-to-SQL)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b
