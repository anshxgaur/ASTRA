# ── DATABASE (canonical structured layer) ──────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=aicte_canonical
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ── SAMPLE SOURCE SYSTEMS (MVP: point these at sample/local DBs) ───────
SOURCE_MYSQL_URI=mysql+mysqlconnector://user:pass@localhost:3306/institution_db
SOURCE_POSTGRES_URI=postgresql+psycopg://user:pass@localhost:5432/course_db
SOURCE_MONGO_URI=mongodb://localhost:27017/faculty_db

# ── EMBEDDINGS ──────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIM=768

# ── LLM (Phase 4 — Groq, for answer synthesis + text-to-SQL) ───────────
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── PIPELINE ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
USE_SAMPLE_DATA=true
